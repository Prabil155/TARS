    def get_cpu_info(self):

        try:

            # Linux / WSL
            if shutil.which("lscpu"):

                result = subprocess.run(
                    ["lscpu"],
                    capture_output=True,
                    text=True,
                    check=False,
                )

                for line in result.stdout.splitlines():

                    if "Model name:" in line:
                        return line.split(
                            ":",
                            1,
                        )[1].strip()

            # Windows fallback
            if platform.system() == "Windows":

                result = subprocess.run(
                    [
                        "wmic",
                        "cpu",
                        "get",
                        "name",
                    ],
                    capture_output=True,
                    text=True,
                    check=False,
                )

                lines = [
                    line.strip()
                    for line in result.stdout.splitlines()
                    if line.strip()
                ]

                if len(lines) > 1:
                    return lines[1]

            return "CPU information unavailable."

        except Exception as error:

            return f"CPU error: {error}"

    # ==========================================================
    # RAM
    # ==========================================================

    def get_ram_info(self):

        try:

            # Linux / WSL
            if shutil.which("free"):

                result = subprocess.run(
                    ["free", "-h"],
                    capture_output=True,
                    text=True,
                    check=False,
                )

                for line in result.stdout.splitlines():

                    if line.startswith("Mem:"):

                        parts = line.split()

                        if len(parts) >= 7:

                            return (
                                f"Total RAM: {parts[1]}, "
                                f"Used: {parts[2]}, "
                                f"Available: {parts[6]}"
                            )

            # Windows fallback
            if platform.system() == "Windows":

                result = subprocess.run(
                    [
                        "wmic",
                        "OS",
                        "get",
                        "TotalVisibleMemorySize,"
                        "FreePhysicalMemory",
                        "/Value",
                    ],
                    capture_output=True,
                    text=True,
                    check=False,
                )

                values = {}

                for line in result.stdout.splitlines():

                    if "=" in line:

                        key, value = line.split(
                            "=",
                            1,
                        )

                        values[key.strip()] = value.strip()

                total = values.get(
                    "TotalVisibleMemorySize"
                )

                free = values.get(
                    "FreePhysicalMemory"
                )

                if total and free:

                    total_gb = (
                        int(total) / 1024 / 1024
                    )

                    free_gb = (
                        int(free) / 1024 / 1024
                    )

                    used_gb = (
                        total_gb - free_gb
                    )

                    return (
                        f"Total RAM: {total_gb:.1f} GB, "
                        f"Used: {used_gb:.1f} GB, "
                        f"Available: {free_gb:.1f} GB"
                    )

            return "RAM information unavailable."

        except Exception as error:

            return f"RAM error: {error}"

    # ==========================================================
    # DISK
    # ==========================================================

    def get_disk_info(self):

        try:

            path = "/"

            # If actually running on Windows
            if platform.system() == "Windows":
                path = "C:\\"

            total, used, free = shutil.disk_usage(path)

            total_gb = total / (1024 ** 3)
            used_gb = used / (1024 ** 3)
            free_gb = free / (1024 ** 3)

            return (
                f"Disk total: {total_gb:.1f} GB, "
                f"used: {used_gb:.1f} GB, "
                f"free: {free_gb:.1f} GB"
            )

        except Exception as error:

            return f"Disk error: {error}"

