    # ==========================================================
    # TOOL EXECUTION
    # ==========================================================

    def execute_tool(
        self,
        tool_name,
        arguments=None,
    ):
        """Execute a tool requested by the model."""

        if arguments is None:
            arguments = {}

        # ------------------------------------------------------
        # SYSTEM INFORMATION
        # ------------------------------------------------------

        if tool_name == "get_cpu_info":
            return self.get_cpu_info()

        if tool_name == "get_ram_info":
            return self.get_ram_info()

        if tool_name == "get_disk_info":
            return self.get_disk_info()

        if tool_name == "get_os_info":
            return self.get_os_info()

        if tool_name == "get_battery_info":
            return self.get_battery_info()

        # ------------------------------------------------------
        # APPLICATIONS
        # ------------------------------------------------------

        if tool_name == "open_brave":
            return self.open_brave()

        if tool_name == "open_calculator":

            try:
                return open_calculator()
            except Exception as error:
                return (
                    f"Calculator error: {error}"
                )

        if tool_name == "open_notepad":

            try:
                return open_notepad()
            except Exception as error:
                return (
                    f"Notepad error: {error}"
                )

        if tool_name == "open_file_explorer":

            try:
                return open_file_explorer()
            except Exception as error:
                return (
                    f"File Explorer error: {error}"
                )

        if tool_name == "open_command_prompt":

            try:
                return open_command_prompt()
            except Exception as error:
                return (
                    f"Command Prompt error: {error}"
                )

        if tool_name == "open_powershell":

            try:
                return open_powershell()
            except Exception as error:
                return (
                    f"PowerShell error: {error}"
                )

        # ------------------------------------------------------
        # MEMORY
        # ------------------------------------------------------

        if tool_name == "save_memory":

            memory = arguments.get(
                "memory",
                "",
            )

            return self.save_memory(memory)

        if tool_name == "search_memory":

            keyword = arguments.get(
                "keyword",
                "",
            )

            return self.search_memory(keyword)

        return f"Unknown tool: {tool_name}"

    # ==========================================================
    # CLEAN MODEL RESPONSE
    # ==========================================================

    def clean_response(self, text):

        if not text:
            return ""

        text = text.strip()

        # Remove Qwen thinking blocks.

        if "</think>" in text:

            text = text.split(
                "</think>",
                1,
            )[1].strip()

        if "<think>" in text:

            text = text.split(
                "<think>",
                1,
            )[0].strip()

        return text

    # ==========================================================
    # ASK TARS
    # ==========================================================

    def ask(self, user_input):

        user_input = user_input.strip()

        if not user_input:
            return ""

        # ------------------------------------------------------
        # FAST DETERMINISTIC COMMANDS
        # ------------------------------------------------------

        fast_result = self.fast_system_command(
            user_input
        )

        if fast_result is not None:

            # Save memory even if the request is handled
            # directly by Python.
            self.check_for_memory(
                user_input
            )

            return fast_result

        # ------------------------------------------------------
        # AUTOMATIC MEMORY SAVE
        # ------------------------------------------------------

        self.check_for_memory(
            user_input
        )

        # ------------------------------------------------------
        # RETRIEVE RELEVANT MEMORIES
        # ------------------------------------------------------

        relevant_memories = (
            self.get_relevant_memories(
                user_input
            )
        )

        # ------------------------------------------------------
        # CREATE USER MESSAGE
        # ------------------------------------------------------

        user_content = user_input

        if relevant_memories:

            memory_text = "\n".join(
                f"- {memory}"
                for memory in relevant_memories
            )

            user_content = f"""
Relevant memories about the user:

{memory_text}

Current user message:

{user_input}

Use these memories when relevant.
Do not mention the memory system unless necessary.
"""

            print(
                "🧠 Relevant memory found."
            )

        # ------------------------------------------------------
        # ADD USER MESSAGE
        # ------------------------------------------------------

        self.messages.append(
            {
                "role": "user",
                "content": user_content,
            }
        )

        # ------------------------------------------------------
        # SELECT MODEL
        # ------------------------------------------------------

        model = self.choose_model(
            user_input
        )

        print(
            f"🧠 Model: {model}"
        )

        # ------------------------------------------------------
        # ASK OLLAMA
        # ------------------------------------------------------

        try:

            if model == self.fast_model:

                response = ollama.chat(
                    model=model,
                    messages=self.messages,
                    think=False,
                )

            else:

                response = ollama.chat(
                    model=model,
                    messages=self.messages,
                    tools=self.tools,
                    think=False,
                )

        except Exception as error:

            # Remove failed user message so the conversation
            # history does not become corrupted.
            if self.messages:
                last_message = self.messages[-1]

                if (
                    last_message.get("role")
                    == "user"
                ):
                    self.messages.pop()

            return (
                f"I couldn't reach the Ollama model. "
                f"Check that Ollama is running and the model "
                f"'{model}' is installed.\n\n"
                f"Error: {error}"
            )

        # ------------------------------------------------------
        # TOOL LOOP
        # ------------------------------------------------------

        while True:

            tool_calls = (
                response["message"].get(
                    "tool_calls"
                )
            )

            if not tool_calls:
                break

            assistant_message = (
                response["message"]
            )

            self.messages.append(
                assistant_message
            )

            for tool_call in tool_calls:

                function = tool_call.get(
                    "function",
                    {},
                )

                tool_name = function.get(
                    "name",
                    "",
                )

                arguments = function.get(
                    "arguments",
                    {},
                )

                # Some Ollama/model versions may return
                # arguments as a JSON string.
                if isinstance(
                    arguments,
                    str,
                ):

                    try:

                        import json

                        arguments = json.loads(
                            arguments
                        )

                    except Exception:

                        arguments = {}

                print(
                    f"🔧 Using tool: {tool_name}"
                )

                try:

                    tool_result = (
                        self.execute_tool(
                            tool_name,
                            arguments,
                        )
                    )

                except Exception as error:

                    tool_result = (
                        f"Tool execution failed: {error}"
                    )

                self.messages.append(
                    {
                        "role": "tool",
                        "content": str(
                            tool_result
                        ),
                    }
                )

            # Ask the smart model to interpret the
            # tool results and produce the final answer.

            try:

                response = ollama.chat(
                    model=self.smart_model,
                    messages=self.messages,
                    tools=self.tools,
                    think=False,
                )

            except Exception as error:

                return (
                    f"The tool ran, but I couldn't "
                    f"generate the final response.\n\n"
                    f"Error: {error}"
                )

        # ------------------------------------------------------
        # FINAL RESPONSE
        # ------------------------------------------------------

        response_text = (
            response["message"].get(
                "content",
                "",
            )
        )

        response_text = (
            self.clean_response(
                response_text
            )
        )

        # ------------------------------------------------------
        # SAVE ASSISTANT RESPONSE
        # ------------------------------------------------------

        self.messages.append(
            {
                "role": "assistant",
                "content": response_text,
            }
        )

        return response_text


