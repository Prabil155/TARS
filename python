    # ==========================================================
    # BATTERY
    # ==========================================================

    def get_battery_info(self):

        try:

            # Linux / WSL
            battery_path = (
                "/sys/class/power_supply/BAT0"
            )

            if platform.system() != "Windows":

                capacity_file = (
                    f"{battery_path}/capacity"
                )

                status_file = (
                    f"{battery_path}/status"
                )

                try:

                    with open(
                        capacity_file,
                        "r",
                        encoding="utf-8",
                    ) as file:
                        capacity = file.read().strip()

                    with open(
                        status_file,
                        "r",
                        encoding="utf-8",
                    ) as file:
                        status = file.read().strip()

                    return (
                        f"Battery: {capacity}% "
                        f"({status})"
                    )

                except FileNotFoundError:

                    return (
                        "Battery information is not "
                        "available through this Linux/WSL environment."
                    )

            # Windows
            result = subprocess.run(
                [
                    "wmic",
                    "path",
                    "Win32_Battery",
                    "get",
                    "EstimatedChargeRemaining,"
                    "BatteryStatus",
                    "/value",
                ],
                capture_output=True,
                text=True,
                check=False,
            )

            values = {}

            for line in result.stdout.splitlines():

                if "=" in line:

                    key, value = line.split(
                        "=",
                        1,
                    )

                    values[key.strip()] = value.strip()

            percentage = values.get(
                "EstimatedChargeRemaining"
            )

            status_code = values.get(
                "BatteryStatus"
            )

            if percentage:

                status_text = {
                    "1": "Discharging",
                    "2": "Charging",
                    "3": "Fully charged",
                    "4": "Low",
                    "5": "Critical",
                    "6": "Charging",
                    "7": "Charging",
                    "8": "Charging",
                    "9": "Charging",
                    "10": "Unknown",
                    "11": "Partially charged",
                }.get(
                    status_code,
                    "Unknown",
                )

                return (
                    f"Battery: {percentage}% "
                    f"({status_text})"
                )

            return "Battery information unavailable."

        except Exception as error:

            return f"Battery error: {error}"

    # ==========================================================
    # BRAVE
    # ==========================================================

    def open_brave(self):

        try:

            # Windows native path
            windows_brave = (
                r"C:\Program Files\BraveSoftware"
                r"\Brave-Browser\Application\brave.exe"
            )

            # WSL path
            wsl_brave = (
                "/mnt/c/Program Files/"
                "BraveSoftware/"
                "Brave-Browser/"
                "Application/"
                "brave.exe"
            )

            if platform.system() == "Windows":

                if shutil.which("brave"):
                    subprocess.Popen(
                        ["brave"]
                    )
                    return "Brave browser opened successfully."

                if shutil.which(windows_brave):
                    subprocess.Popen(
                        [windows_brave]
                    )
                    return "Brave browser opened successfully."

                return "Brave browser was not found."

            if shutil.which(wsl_brave):

                subprocess.Popen(
                    [wsl_brave]
                )

                return "Brave browser opened successfully."

            # WSL can use Windows shell as a fallback.
            if shutil.which("cmd.exe"):

                subprocess.Popen(
                    [
                        "cmd.exe",
                        "/c",
                        "start",
                        "",
                        "brave",
                    ]
                )

                return "Brave browser opened successfully."

            return "Brave browser was not found."

        except Exception as error:

            return f"Could not open Brave: {error}"

