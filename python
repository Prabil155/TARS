    # ==========================================================
    # MEMORY SEARCH
    # ==========================================================

    def search_memory(self, keyword):

        if not keyword:
            return "No search keyword was provided."

        try:

            results = self.memory.search(keyword)

            if not results:
                return "No matching memories found."

            memories = []

            for item in results:

                if item and item[0]:

                    memories.append(
                        str(item[0])
                    )

            if not memories:
                return "No matching memories found."

            return "\n".join(memories)

        except Exception as error:

            return (
                f"Memory search error: {error}"
            )

    # ==========================================================
    # RELEVANT MEMORY RETRIEVAL
    # ==========================================================

    def get_relevant_memories(self, user_input):

        try:

            results = self.memory.search(
                user_input
            )

            if not results:
                return []

            memories = []

            for item in results[:5]:

                if not item:
                    continue

                memory_text = str(
                    item[0]
                ).strip()

                if (
                    memory_text
                    and memory_text not in memories
                ):
                    memories.append(
                        memory_text
                    )

            return memories

        except Exception as error:

            print(
                f"⚠️ Memory retrieval failed: {error}"
            )

            return []

