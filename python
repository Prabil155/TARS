    def check_for_memory(self, user_input):
        """
        Decide whether the current message contains
        information worth saving permanently.
        """

        text = user_input.lower().strip()

        memory_triggers = [
            "my name is",
            "i am",
            "i'm",
            "i live",
            "i study",
            "i work",
            "i use",
            "i like",
            "i love",
            "i prefer",
            "my favorite",
            "my favourite",
            "remember that",
            "remember this",
            "don't forget",
            "do not forget",
            "keep in mind",
            "i'm building",
            "i am building",
            "my project",
            "my goal",
        ]

        possible_memory = any(
            trigger in text
            for trigger in memory_triggers
        )

        if not possible_memory:
            return

        try:

            memory_prompt = f"""
You are the memory manager for TARS.

Determine whether this user message contains
important information that should be remembered
for future conversations.

User message:
"{user_input}"

SAVE information such as:
- Name
- Long-term projects
- Important goals
- Important preferences
- Important computer/software setup
- Information explicitly requested to be remembered

DO NOT SAVE:
- Temporary information
- Casual conversation
- One-time requests
- Questions
- Jokes

Return ONLY one of these formats:

SAVE: <short memory>

OR:

IGNORE
"""

            response = ollama.chat(
                model=self.memory_model,
                messages=[
                    {
                        "role": "user",
                        "content": memory_prompt,
                    }
                ],
                think=False,
            )

            result = response["message"].get(
                "content",
                "",
            ).strip()

            if result.upper().startswith("SAVE:"):

                memory_text = result[
                    len("SAVE:")
                ].strip()

                if memory_text:
                    self.memory.save(memory_text)

                    print(
                        f"🧠 Memory saved: {memory_text}"
                    )

        except Exception as error:

            # Memory must never crash TARS.
            print(
                f"⚠️ Memory check failed: {error}"
            )

