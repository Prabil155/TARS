    def choose_model(self, user_input):
        """Choose between the fast and smart model."""

        text = user_input.lower().strip()

        tool_keywords = [
            "cpu",
            "processor",
            "ram",
            "memory usage",
            "disk",
            "storage",
            "battery",
            "operating system",
            " os ",
            "open brave",
            "open browser",
            "launch brave",
            "launch browser",
            "open calculator",
            "open notepad",
            "open file explorer",
            "open command prompt",
            "open powershell",
        ]

        for keyword in tool_keywords:
            if keyword in text:
                return self.smart_model

        complex_keywords = [
            "explain",
            "analyze",
            "debug",
            "write code",
            "create code",
            "program",
            "how does",
            "how do",
            "why does",
            "why do",
            "compare",
            "difference between",
            "architecture",
            "design",
            "calculate",
            "solve",
            "implement",
            "build",
            "configure",
            "install",
            "error",
            "problem",
            "issue",
        ]

        for keyword in complex_keywords:
            if keyword in text:
                return self.smart_model

        return self.fast_model

    # ==========================================================
